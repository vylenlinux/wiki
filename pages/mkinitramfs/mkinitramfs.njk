        <h2 id="options">Options</h2>

        <table>
            <thead>
                <tr>
                    <th>Option</th>
                    <th>Argument</th>
                    <th>Behavior</th>
                </tr>
            </thead>

            <tbody>
                <tr>
                    <td>
                        <code>-k</code>
                    </td>

                    <td>release</td>

                    <td>
                        Use this kernel release instead of
                        <code>uname -r</code>.
                    </td>
                </tr>

                <tr>
                    <td>
                        <code>-o</code>
                    </td>

                    <td>file</td>
                    <td>Write the generated image to a specific path.</td>
                </tr>

                <tr>
                    <td>
                        <code>-i</code>
                    </td>

                    <td>file</td>

                    <td>
                        Use a custom init script as <code>/init</code>.
                    </td>
                </tr>

                <tr>
                    <td>
                        <code>-c</code>
                    </td>

                    <td>file</td>
                    <td>Read an alternate configuration.</td>
                </tr>

                <tr>
                    <td>
                        <code>-C</code>
                    </td>

                    <td>gzip|xz|zstd|lz4|none</td>
