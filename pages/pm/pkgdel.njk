<section class="hero compact">
    <p class="eyebrow">EMERALD / PACKAGE DATABASE</p>
    <h1>pkgdel</h1>

    <p class="lead">
        Remove an installed package using the file ownership recorded in the
        Vylen package database.
    </p>

    <div class="command-line"># pkgdel [options] &lt;port&gt;</div>
</section>

<section class="doc-grid">
    <aside class="toc">
        <p class="toc-title">pkgdel</p>

        <a href="#/pm/pkgdel#usage">Usage</a>
